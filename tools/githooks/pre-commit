#!/bin/sh
# Pre-commit gate. Install once: make install-hooks. Bypass for a WIP commit: git commit --no-verify.
#
#   1. Staged C sources must be clang-format-clean (checks the STAGED content, non-destructive -
#      run `make format` to fix).
#   2. Every commit runs the Python tests. Store/source changes run `make check`, which includes
#      the tests, store checks and ROM verification. These gates validate the WORKING TREE, not
#      the staged snapshot. ROM verification skips the comparison if the dump is absent.
#   3. If hacks or the stores/headers they consume changed, `make check-hacks` must pass (builds
#      every patch, ROM-free).

# --- 1. clang-format check (staged content) ---
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.[ch]$')
if [ -n "$files" ]; then
	bad=""
	for f in $files; do
		git show ":$f" | clang-format --assume-filename="$f" --dry-run --Werror >/dev/null 2>&1 \
			|| bad="$bad $f"
	done
	if [ -n "$bad" ]; then
		echo "pre-commit: these staged files need formatting:" >&2
		for f in $bad; do echo "  $f" >&2; done
		echo "fix with:  make format   (then re-stage with git add)" >&2
		exit 1
	fi
fi

# --- 2. tests on every commit, plus ROM/store checks when those inputs changed ---
if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(config/|include/|src/|carved/)'; then
	gate=check
else
	gate=test
fi
echo "pre-commit: make $gate..." >&2
make "$gate" >&2 || {
	echo "pre-commit: make $gate failed - fix it, or commit WIP with: git commit --no-verify" >&2
	exit 1
}
# --- 3. hacks must compile (ROM-free: builds every patch with the base-ROM sha gate skipped) ---
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(hacks/|config/|include/|carved/)'; then
	echo "pre-commit: make check-hacks..." >&2
	make check-hacks >&2 || {
		echo "pre-commit: hacks failed to build - fix it, or commit WIP with: git commit --no-verify" >&2
		exit 1
	}
fi
exit 0
