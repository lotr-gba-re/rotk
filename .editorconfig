root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
tab_width = 4
indent_style = space

[*.{c,h}]
max_line_length = 100

[carved/data/**]
max_line_length = unset

[carved-local/include/**]
max_line_length = unset

[*.py]
max_line_length = 88

# Makefiles and make/*.mk use hard tabs (required by make).
[{Makefile,make/*.mk,*.mk}]
indent_style = tab
max_line_length = unset

# TAB-delimited stores: config/functions.cfg, config/data.cfg, config/split.cfg (\t addr name ...).
# Editors must not expand/convert the field-separator tabs.
[*.cfg]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = unset

[*.md]
max_line_length = unset
