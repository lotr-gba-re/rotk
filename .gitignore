# Exclude probable ROM files just to be safe
*.gba
*.zip

# Scratch folder for local files (e.g. for ad-hoc testing)
/local/

# Build outputs
/build/
/dist/

# Python
.venv/
__pycache__/
*.pyc

# Generated Ghidra project
ghidra_proj/

# agbcc (period compiler for matching decomp; build via tools/setup_agbcc.sh)
tools/agbcc/

# Objdiff project config (generated by `make objdiff`; references gitignored build/ paths)
objdiff.json

# ROM-derived analysis dumps
tools/out/

# clangd compilation database (per-clone editor aid; regenerate with `make clangd`)
compile_commands.json
hacks/compile_flags.txt
.cache/

# LLM MCP information
.mcp.json

